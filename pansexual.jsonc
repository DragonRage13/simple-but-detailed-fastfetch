{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
  "type": "file",
  "source": "~/.config/fastfetch/logos/pansexual.txt",
  "padding": { "top": 1, "right": 3 },
  "color": {
    "1": "38;5;198",
    "2": "38;5;220",
    "3": "38;5;39",
  }
},
  "display": {
    "separator": " ",
    "key": { "width": 12 },
    "color": { "keys": "red", "output": "white", "separator": "black" },
    "size": { "binaryPrefix": "iec" },
    "percent": { "type": 9, "green": 40, "yellow": 70 }
  },
  "modules": [
  {"type": "title", "format": "{#38;5;198}{user-name}{#}{#38;5;198}@{#}{#38;5;198}{host-name}{#}"},
  {"type": "separator", "string": "─", "outputColor": "38;5;231"},

    { "type": "custom", "format": "{#38;5;198}┌─ System"},
    { "type": "os",       "key": "│ Distro",   "keyColor": "38;5;198" },
    { "type": "disk",     "key": "│ Age", "keyColor": "38;5;169", "folders": "/", "format": "{create-time:10} ({days} days)"},
    { "type": "host",     "key": "│ Host",     "keyColor": "38;5;198" },
    { "type": "bios",     "key": "│ BIOS",     "keyColor": "38;5;198" },
    { "type": "bootmgr",  "key": "│ Boot",     "keyColor": "38;5;198" },
    { "type": "kernel",   "key": "│ Kernel",   "keyColor": "38;5;198" },
    { "type": "packages", "key": "│ Packages", "keyColor": "38;5;198" },
    { "type": "uptime",   "key": "│ Uptime",   "keyColor": "38;5;198" },
    "break",

    { "type": "custom", "format": "{#38;5;198}┌─ Desktop" },
    { "type": "de",       "key": "│ DE",     "keyColor": "38;5;198" },
    { "type": "wm",       "key": "│ WM",     "keyColor": "38;5;198" },
    { "type": "wmtheme",  "key": "│ Theme",  "keyColor": "38;5;198" },
    { "type": "locale",   "key": "│ Locale", "keyColor": "38;5;198" },
    { "type": "font",     "key": "│ Font",   "keyColor": "38;5;198" },
    "break",

    { "type": "custom", "format": "{#38;5;220}┌─ Terminal" },
    { "type": "terminal",     "key": "│ Terminal", "keyColor": "38;5;220" },
    { "type": "shell",        "key": "│ Shell",    "keyColor": "38;5;220" },
    { "type": "terminalfont", "key": "│ Font", "keyColor": "38;5;220" },
    "break",

    { "type": "custom", "format": "{#38;5;220}┌─ Hardware" },
    { "type": "cpu",   "key": "│ CPU",   "keyColor": "38;5;220" },
    { "type": "codec", "key": "│ Codec", "keyColor": "38;5;220" },
    "break",

    { "type": "custom", "format": "{#38;5;39}┌─ Graphics" },
    { "type": "gpu",     "key": "│ GPU",     "keyColor": "38;5;39" },
    { "type": "display", "key": "│ Display", "keyColor": "38;5;39" },
    { "type": "vulkan",  "key": "│ Vulkan",  "keyColor": "38;5;39" },
    { "type": "opengl",  "key": "│ OpenGL",  "keyColor": "38;5;39" },
    { "type": "opencl",  "key": "│ OpenCL",  "keyColor": "38;5;39" },
    "break",

    { "type": "custom", "format": "{#38;5;39}┌─ Memory & Storage"},
    { "type": "memory", "key": "│ Memory", "keyColor": "38;5;39" },
    { "type": "swap",   "key": "│ Swap",   "keyColor": "38;5;39" },
    { "type": "disk",   "key": "│ Disk", "keyColor": "38;5;39" },
    "break",

    { "type": "version", "key": "Version", "keyColor": "38;5;198" },
    { "type": "colors", "symbol": "circle"}
  ]
}
