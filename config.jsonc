{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "cachyos" },
  "display": {
    "separator": " ",
    "key": { "width": 12 },
    "color": { "keys": "red", "output": "white", "separator": "black" },
    "size": { "binaryPrefix": "iec" },
    "percent": { "type": 9, "green": 40, "yellow": 70 }
  },
  "modules": [
    "title",
    "separator",

    { "type": "custom", "format": "{#31}┌─ System"},
    { "type": "os",       "key": "│ Distro",   "keyColor": "red" },
    { "type": "disk",     "key": "│ Age", "keyColor": "red", "folders": "/", "format": "{create-time:10} ({days} days)"},
    { "type": "host",     "key": "│ Host",     "keyColor": "red" },
    { "type": "bios",     "key": "│ BIOS",     "keyColor": "red" },
    { "type": "bootmgr",  "key": "│ Boot",     "keyColor": "red" },
    { "type": "kernel",   "key": "│ Kernel",   "keyColor": "red" },
    { "type": "packages", "key": "│ Packages", "keyColor": "red" },
    { "type": "uptime",   "key": "│ Uptime",   "keyColor": "red" },
    "break",

    { "type": "custom", "format": "{#32}┌─ Desktop" },
    { "type": "de",       "key": "│ DE",     "keyColor": "green" },
    { "type": "wm",       "key": "│ WM",     "keyColor": "green" },
    { "type": "wmtheme",  "key": "│ Theme",  "keyColor": "green" },
    { "type": "locale",   "key": "│ Locale", "keyColor": "green" },
    { "type": "font",     "key": "│ Font",   "keyColor": "green" },
    "break",

    { "type": "custom", "format": "{#33}┌─ Terminal" },
    { "type": "terminal",     "key": "│ Terminal", "keyColor": "yellow" },
    { "type": "shell",        "key": "│ Shell",    "keyColor": "yellow" },
    { "type": "terminalfont", "key": "│ Font", "keyColor": "yellow" },
    "break",

    { "type": "custom", "format": "{#34}┌─ Hardware" },
    { "type": "cpu",   "key": "│ CPU",   "keyColor": "blue" },
    { "type": "codec", "key": "│ Codec", "keyColor": "blue" },
    "break",

    { "type": "custom", "format": "{#35}┌─ Graphics" },
    { "type": "gpu",     "key": "│ GPU",     "keyColor": "magenta" },
    { "type": "display", "key": "│ Display", "keyColor": "magenta" },
    { "type": "vulkan",  "key": "│ Vulkan",  "keyColor": "magenta" },
    { "type": "opengl",  "key": "│ OpenGL",  "keyColor": "magenta" },
    { "type": "opencl",  "key": "│ OpenCL",  "keyColor": "magenta" },
    "break",

    { "type": "custom", "format": "{#36}┌─ Memory & Storage" },
    { "type": "memory", "key": "│ Memory", "keyColor": "cyan" },
    { "type": "swap",   "key": "│ Swap",   "keyColor": "cyan" },
    { "type": "disk",   "key": "│ Disk", "keyColor": "cyan" },
    "break",

    { "type": "version", "key": "Version", "keyColor": "red" },
    { "type": "colors", "symbol": "circle"}
  ]
}
