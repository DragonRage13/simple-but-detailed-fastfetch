{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
  "type": "file",
  "source": "~/.config/fastfetch/logos/genderfluid.txt",
  "padding": { "top": 1, "right": 3 },
  "color": {
    "1": "38;5;211",
    "2": "38;5;231",
    "3": "38;5;128",
    "4": "38;5;16",
    "5": "38;5;19"
  }
},
  "display": {
    "separator": " ",
    "key": { "width": 12 },
    "color": { "keys": "red", "output": "white", "separator": "black" },
    "size": { "binaryPrefix": "iec" },
    "percent": { "type": 9, "green": 40, "yellow": 70 }
  },
"modules": [
  {"type": "title", "format": "{#38;5;211}{user-name}{#}{#38;5;211}@{#}{#38;5;211}{host-name}{#}"},
  {"type": "separator", "string": "─", "outputColor": "38;5;231"},

    { "type": "custom", "format": "{#38;5;211}┌─ System"},
    { "type": "os",       "key": "│ Distro",   "keyColor": "38;5;211" },
    { "type": "disk",     "key": "│ Age", "keyColor": "38;5;211", "folders": "/", "format": "{create-time:10} ({days} days)"},
    { "type": "host",     "key": "│ Host",     "keyColor": "38;5;211" },
    { "type": "bios",     "key": "│ BIOS",     "keyColor": "38;5;211" },
    { "type": "bootmgr",  "key": "│ Boot",     "keyColor": "38;5;211" },
    { "type": "kernel",   "key": "│ Kernel",   "keyColor": "38;5;211" },
    { "type": "packages", "key": "│ Packages", "keyColor": "38;5;211" },
    { "type": "uptime",   "key": "│ Uptime",   "keyColor": "38;5;211" },
    "break",

    { "type": "custom", "format": "{#38;5;231}┌─ Desktop" },
    { "type": "de",       "key": "│ DE",     "keyColor": "38;5;231" },
    { "type": "wm",       "key": "│ WM",     "keyColor": "38;5;231" },
    { "type": "wmtheme",  "key": "│ Theme",  "keyColor": "38;5;231" },
    { "type": "locale",   "key": "│ Locale", "keyColor": "38;5;231" },
    { "type": "font",     "key": "│ Font",   "keyColor": "38;5;231" },
    "break",

    { "type": "custom", "format": "{#38;5;128}┌─ Terminal" },
    { "type": "terminal",     "key": "│ Terminal", "keyColor": "38;5;128" },
    { "type": "shell",        "key": "│ Shell",    "keyColor": "38;5;128" },
    { "type": "terminalfont", "key": "│ Font", "keyColor": "38;5;128" },
    "break",

    { "type": "custom", "format": "{#38;5;16}┌─ Hardware" },
    { "type": "cpu",   "key": "│ CPU",   "keyColor": "38;5;16" },
    { "type": "codec", "key": "│ Codec", "keyColor": "38;5;16" },
    "break",

    { "type": "custom", "format": "{#38;5;16}┌─ Graphics" },
    { "type": "gpu",     "key": "│ GPU",     "keyColor": "38;5;16" },
    { "type": "display", "key": "│ Display", "keyColor": "38;5;16" },
    { "type": "vulkan",  "key": "│ Vulkan",  "keyColor": "38;5;16" },
    { "type": "opengl",  "key": "│ OpenGL",  "keyColor": "38;5;16" },
    { "type": "opencl",  "key": "│ OpenCL",  "keyColor": "38;5;16" },
    "break",

    { "type": "custom", "format": "{#38;5;19}┌─ Memory & Storage"},
    { "type": "memory", "key": "│ Memory", "keyColor": "38;5;19" },
    { "type": "swap",   "key": "│ Swap",   "keyColor": "38;5;19" },
    { "type": "disk",   "key": "│ Disk", "keyColor": "38;5;19" },
    "break",

    { "type": "version", "key": "Version", "keyColor": "38;5;211" },
    { "type": "colors", "symbol": "circle"}
  ]
}
